# vLLM 服务参数：由 serve.sh 读取。部署时复制为 /mnt/storage/vllm/vllm.env（权限 600）并填写 API key
CUDA_VISIBLE_DEVICES=0
VLLM_MODEL=/mnt/storage/models/Qwen3.5-9B-NVFP4
VLLM_SERVED_NAME=Qwen3.5-9B
VLLM_HOST=172.17.0.1
VLLM_PORT=4002
VLLM_MAX_LEN=65536
VLLM_MAX_SEQS=32
# 生成：echo sk-vllm-$(openssl rand -hex 16)；litegate 凭证的 api_key 填同一个值
VLLM_API_KEY=sk-vllm-CHANGE-ME
