# /etc/litegate/litegate.env（权限 0600，属主 root）
# 格式：KEY=VALUE，一行一个；也可在控制台「运行参数」页在线修改大多数参数

# 上游 Key 加密主密钥（base64 的 32 字节）；生成：openssl rand -base64 32
# 未设置时使用 /var/lib/litegate/secret.key（首次启动自动生成，务必备份）
#LITEGATE_ENCRYPTION_KEY=

# 监听端口（默认 4000）
#LITEGATE_HTTP_PORT=4000
# 监听地址（单机默认 127.0.0.1；容器内必须 0.0.0.0，再由端口映射/防火墙决定暴露面）
#LITEGATE_HTTP_BIND=127.0.0.1

# 控制台登录（默认 false：免登录，任何能访问端口的人都可管理）
#LITEGATE_CONSOLE_AUTH=true
# 开启登录且还没有账号时，首次启动创建 admin 的密码（未设置则随机生成并写入日志）
#LITEGATE_ADMIN_PASSWORD=

# 日志保留天数（默认 30）、用量汇总保留天数（默认 400）
#LITEGATE_LOG_RETENTION_DAYS=30
#LITEGATE_USAGE_RETENTION_DAYS=400
