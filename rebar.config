{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_untyped_record
]}.

%% OTP 27+ stdlib json；本机为 OTP 28
{minimum_otp_vsn, "27"}.

{project_app_dirs, ["apps/*"]}.

%% hex 镜像（国内网络访问 repo.hex.pm 不可达时；upyun 官方合作镜像）
{hex, [{repos, [#{name => <<"hexpm">>, repo_url => <<"https://hexpm.upyun.com">>}]}]}.

{deps, [
    {cowboy, "2.13.0"},
    {gun, "2.1.0"},
    {bitcask, {git, "https://github.com/DavidAlphaFox/bitcask.git", {tag, "6.6.0"}}}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [lg_core, lg_catalog, lg_provider, lg_router, lg_store, lg_web]}
]}.

{relx, [
    {release, {litegate, "1.1.0"}, [
        sasl,
        {mnesia, load},  %% 由 lg_core 设置数据目录后启动
        lg_core,
        lg_catalog,
        lg_provider,
        lg_router,
        lg_store,
        lg_web
    ]},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {mode, dev},
    {extended_start_script, true}
]}.

{profiles, [
    %% 生产 release：包含 ERTS，解压即用；构建前需先构建前端（scripts/release.sh）
    {prod, [{relx, [{mode, prod}, {include_src, false}]}]},
    {test, [{deps, [{meck, "0.9.2"}]}, {erl_opts, [nowarn_export_all]}]}
]}.

%% mnesia 不在 lg_core 的 applications 里（lg_schema 设好数据目录后才启动），
%% 需要显式加入 dialyzer 的 PLT。
{dialyzer, [{warnings, [error_handling, unmatched_returns, unknown]},
            {plt_extra_apps, [mnesia]}]}.


{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used,
               deprecated_function_calls, deprecated_functions]}.

%% rebar3 shell 与 release 使用同一节点名：mnesia disc schema 与节点名绑定
{dist_node, [{sname, litegate}, {setcookie, litegate}]}.
